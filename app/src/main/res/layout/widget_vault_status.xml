<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_bunker"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top Header Row: Mars Outpost Identity, Defense Badge & Quick Sync -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_vault_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="ARES OUTPOST v25.0 • SOL 1 • LV.1"
                android:textColor="#FFAB40"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status_alert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="🟢 PREP DAY 1/10 (0 ATTACKS) • ALL SYSTEMS NOMINAL"
                android:textColor="#66BB6A"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_attack_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_pill_bg"
            android:paddingLeft="6dp"
            android:paddingTop="3dp"
            android:paddingRight="6dp"
            android:paddingBottom="3dp"
            android:text="🛡 PREP 10D"
            android:textColor="#4DD0E1"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_bg"
            android:paddingLeft="7dp"
            android:paddingTop="3dp"
            android:paddingRight="7dp"
            android:paddingBottom="3dp"
            android:text="↻ v25.0"
            android:textColor="#80DEEA"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Storage Capacity & Slowdown Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_pill_bg"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="7dp"
        android:paddingTop="3dp"
        android:paddingRight="7dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_storage_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="📦 Storage Cap: 6/150 (4%) • Full Speed (100%)"
                android:textColor="#FFF3E0"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_prep_and_clocks_banner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="⏳ 10d Peace • Cap 150"
                android:textColor="#B0BEC5"
                android:textSize="9sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_storage_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="2dp"
            android:max="100"
            android:progress="4"
            android:progressTint="#4DD0E1" />
    </LinearLayout>

    <!-- Row 1: Primary Survival Resources (Regolith Scrap, Water Ice, Bio-Food) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_bg"
            android:orientation="vertical"
            android:paddingLeft="6dp"
            android:paddingTop="3dp"
            android:paddingRight="6dp"
            android:paddingBottom="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙ REGOLITH SCRAP"
                android:textColor="#FFB74D"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_res_scrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="0.0 (+0.0/s)"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_bg"
            android:orientation="vertical"
            android:paddingLeft="6dp"
            android:paddingTop="3dp"
            android:paddingRight="6dp"
            android:paddingBottom="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💧 WATER ICE"
                android:textColor="#4DD0E1"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_res_water"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="6.0 (+0.0/s)"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_bg"
            android:orientation="vertical"
            android:paddingLeft="6dp"
            android:paddingTop="3dp"
            android:paddingRight="6dp"
            android:paddingBottom="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌱 BIO-RATIONS"
                android:textColor="#81C784"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_res_food"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="6.0 (+0.0/s)"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2: Secondary Resources & Defense (Methalox Fuel, Credits Gold, Airlock DEF & Ammo) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_bg"
            android:orientation="vertical"
            android:paddingLeft="6dp"
            android:paddingTop="3dp"
            android:paddingRight="6dp"
            android:paddingBottom="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 METHALOX FUEL"
                android:textColor="#FF8A65"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_res_fuel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="0.0 (+0.0/s)"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_bg"
            android:orientation="vertical"
            android:paddingLeft="6dp"
            android:paddingTop="3dp"
            android:paddingRight="6dp"
            android:paddingBottom="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪙 MARS CREDITS"
                android:textColor="#FFD54F"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_res_gold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="🪙 0.0G (+0.0/s)"
                android:textColor="#FFF59D"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_bg"
            android:orientation="vertical"
            android:paddingLeft="6dp"
            android:paddingTop="3dp"
            android:paddingRight="6dp"
            android:paddingBottom="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡 AIRLOCK DEF"
                android:textColor="#90CAF9"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_res_defense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="🛡 20 DEF • 20 Rds"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 3: 3 One-Tap Out-of-Game Command Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="3">

        <TextView
            android:id="@+id/widget_btn_quick_mine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_bg"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="⛏ DRILL (+RES)"
            android:textColor="#FFD54F"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_quick_supply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_bg"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="💧 ICE &amp; FOOD"
            android:textColor="#4DD0E1"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_quick_stabilize"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_bg"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="⚡ FIX / POWER"
            android:textColor="#69F0AE"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Telemetry & Action Feedback Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_dwellers_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="👥 0/4 • STAM 100% • ⚡ OK (8/0MW)"
            android:textColor="#B0BEC5"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_systems_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="Tap ⛏ DRILL, 💧 ICE &amp; FOOD, or ⚡ FIX"
            android:textColor="#80DEEA"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
